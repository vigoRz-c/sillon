root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.ps1]
# Le script PowerShell doit garder son BOM UTF-8 (accents sous Windows PowerShell 5.1).
charset = utf-8-bom
end_of_line = crlf
