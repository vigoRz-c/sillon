{
  "name": "sillon",
  "productName": "Sillon",
  "version": "0.1.9",
  "description": "Visualiseur musical posé sur le fond d'écran Windows, synchronisé avec Spotify (et tout lecteur qui expose ses contrôles média).",
  "main": "src/main/main.js",
  "author": "Loïc Restout",
  "repository": {
    "type": "git",
    "url": "https://github.com/vigoRz-c/sillon.git"
  },
  "license": "GPL-3.0-only",
  "private": true,
  "scripts": {
    "start": "electron .",
    "prestart": "node scripts/build-helper.js",
    "dev": "electron . --dev",
    "predev": "node scripts/build-helper.js",
    "build:helper": "node scripts/build-helper.js",
    "check": "node scripts/check.js",
    "lint": "eslint .",
    "test": "node --test",
    "verify": "npm run check && npm run lint && npm test",
    "dist": "node scripts/build-helper.js --strict && electron-builder --win",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "koffi": "^3.3.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0"
  },
  "build": {
    "appId": "com.loicrestout.sillon",
    "productName": "Sillon",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/sillon-helper/target/release/sillon-helper.exe",
        "to": "sillon-helper.exe"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Sillon-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "vigoRz-c",
        "repo": "sillon",
        "releaseType": "release"
      }
    ],
    "portable": {
      "artifactName": "Sillon-${version}-portable.${ext}"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
