{
  "name": "sillon",
  "productName": "Sillon",
  "version": "0.1.1",
  "description": "Visualiseur musical posé sur le fond d'écran Windows, synchronisé avec Spotify (et tout lecteur qui expose ses contrôles média).",
  "main": "src/main/main.js",
  "author": "Loïc Restout",
  "repository": {
    "type": "git",
    "url": "https://github.com/vigoRz-c/sillon.git"
  },
  "license": "GPL-3.0-only",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "check": "node scripts/check.js",
    "test": "node --test",
    "dist": "electron-builder --win",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "koffi": "^2.9.0"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.loicrestout.sillon",
    "productName": "Sillon",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/main/media-helper.ps1",
        "to": "media-helper.ps1"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Sillon-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "vigoRz-c",
        "repo": "sillon",
        "releaseType": "release"
      }
    ],
    "portable": {
      "artifactName": "Sillon-${version}-portable.${ext}"
    }
  }
}
