{
  "name": "sillon",
  "productName": "Sillon",
  "version": "0.4.4",
  "description": "Music visualizer on the Windows wallpaper, synced with Spotify (and any player that exposes its media controls).",
  "main": "src/main/app/main.js",
  "author": "Loïc Restout",
  "repository": {
    "type": "git",
    "url": "https://github.com/vigoRz-c/sillon.git"
  },
  "license": "GPL-3.0-only",
  "private": true,
  "scripts": {
    "start": "electron .",
    "prestart": "node scripts/build-helper.js",
    "dev": "electron . --dev",
    "predev": "node scripts/build-helper.js",
    "build:helper": "node scripts/build-helper.js",
    "check": "node scripts/check.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p jsconfig.json",
    "format": "prettier --write \"**/*.{js,css,html,yml}\" package.json",
    "format:check": "prettier --check \"**/*.{js,css,html,yml}\" package.json",
    "test": "node --test",
    "verify": "npm run check && npm run lint && npm run typecheck && npm run format:check && npm test && node scripts/verify-rust.js",
    "verify:rust": "node scripts/verify-rust.js --strict",
    "dist": "node scripts/build-helper.js --strict && electron-builder --win",
    "release": "node scripts/release.js",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "koffi": "^3.3.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.loicrestout.sillon",
    "productName": "Sillon",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/sillon-helper/target/release/sillon-helper.exe",
        "to": "sillon-helper.exe"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Sillon-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "vigoRz-c",
        "repo": "sillon",
        "releaseType": "release"
      }
    ],
    "portable": {
      "artifactName": "Sillon-${version}-portable.${ext}"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "prettier": {
    "printWidth": 120,
    "singleQuote": true,
    "trailingComma": "all",
    "arrowParens": "always",
    "endOfLine": "lf"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.9"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.js": [
      "eslint --max-warnings 0",
      "prettier --check"
    ],
    "*.{css,html,yml}": "prettier --check"
  }
}
